{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pengguna, siswa, atau admin pembelajaran bahasa Arab",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "student"], "maxLength": 32 },
        "schoolClass": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "ReadingText": {
      "title": "ReadingText",
      "description": "Teks materi Maharah Qira'ah MA Kelas 10",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "titleArabic": { "type": "string", "maxLength": 200 },
        "theme": { "type": "string", "maxLength": 100 },
        "contentArabic": { "type": "string", "maxLength": 10000 },
        "contentTranslation": { "type": "string", "maxLength": 10000 },
        "level": { "type": "string", "maxLength": 32 },
        "authorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "titleArabic", "contentArabic"]
    },
    "QuizSubmission": {
      "title": "QuizSubmission",
      "description": "Hasil pengerjaan latihan Maharah Qira'ah siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "textId": { "type": "string", "maxLength": 128 },
        "score": { "type": "number" },
        "submittedAt": { "type": "string" }
      },
      "required": ["userId", "textId", "score"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Koleksi data profil pengguna yang hanya dapat dibaca/ditulis oleh pemilik akun"
    },
    "/user_data/{userId}/{documentId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Koleksi data privat spesifik per user"
    },
    "/quiz_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/QuizSubmission" },
      "description": "Hasil kuis siswa yang hanya dapat dibaca oleh siswa bersangkutan dan guru pengampu"
    },
    "/reading_texts/{textId}": {
      "schema": { "$ref": "#/entities/ReadingText" },
      "description": "Koleksi materi bacaan qira'ah MA Kelas 10"
    }
  }
}
